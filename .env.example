# OPCIONAL: este arquivo é apenas um modelo.
# Não é necessário criar um arquivo .env para usar consultas públicas.
# Sem configuração, o backend usa os endpoints oficiais padrão e o frontend usa /api.

# API oficial DEMAS - mantém o domínio e o Swagger oficiais por padrão
HEALTH_API_BASE_URL=https://apidadosabertos.saude.gov.br
HEALTH_API_SWAGGER_URL=https://apidadosabertos.saude.gov.br/static/swagger.json
HEALTH_API_TIMEOUT_MS=12000
HEALTH_API_CACHE_TTL_SECONDS=600
HEALTH_MIN_AGGREGATE_COUNT=5

# Backend
# Em produção na Vercel, a mesma origem do site já é permitida automaticamente.
# Adicione aqui apenas origens externas confiáveis, separadas por vírgula.
PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=90

# Supabase: opcional para consultas públicas; necessário para login e persistência.
# Nunca use a chave secret/service role no front-end.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Front-end
VITE_API_BASE_URL=/api

# Google Maps: opcional. Sem esta chave, o mapa alternativo permanece disponível.
# Em produção, configure diretamente na Vercel (Settings > Environment Variables).
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=
